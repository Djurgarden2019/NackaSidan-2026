# Auth.js / GitHub OAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# Comma-separated e-mail addresses. Keep these in Vercel Environment Variables.
AUTH_ADMIN_EMAILS=admin@example.com
AUTH_EDITOR_EMAILS=editor@example.com
